# PostgreSQL development defaults. Copy this file to .env before starting services.
POSTGRES_DB=devinsight
POSTGRES_USER=devinsight
POSTGRES_PASSWORD=devinsight_local_only
POSTGRES_PORT=5432

# Backend development settings.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=1209600
